ARG BASE_IMAGE
FROM ${BASE_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends plantuml graphviz fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
ENV PLANTUML_JAR=/usr/share/plantuml/plantuml.jar GRAPHVIZ_DOT=/usr/bin/dot
RUN test -f "$PLANTUML_JAR" && java -DPLANTUML_SECURITY_PROFILE=SECURE -jar "$PLANTUML_JAR" -version >/dev/null
